rules_version = '2';

// Regras do Firebase Storage para as fotos anexadas às atividades.
// Cole em Firebase Console > Storage > Regras.
//
// Mesmo raciocínio das regras do Firestore: sem login, liberado para quem
// tiver o link, limitado a imagens pequenas dentro da pasta "entries/".
service firebase.storage {
  match /b/{bucket}/o {
    match /entries/{entryId} {
      allow read: if true;
      allow write: if request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
      allow delete: if true;
    }
  }
}
